library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity UART is
    generic (
        g_CLKS_PER_BIT : integer := 521 -- For 5 MHz clock and 9600 baud
    );
    port (
        i_Clk       : in  std_logic;                    -- 50 MHz input clock
        i_RX_Serial : in  std_logic;                    -- UART RX input
        o_LED       : out std_logic_vector(7 downto 0)  -- LED output
    );
end UART;

architecture rtl of UART is

    ----------------------------------------------------------------
    -- Internal clocks from clock divider
    ----------------------------------------------------------------
    signal clk_5MHz : std_logic;
    signal clk_2Hz  : std_logic;

    ----------------------------------------------------------------
    -- UART RX signals
    ----------------------------------------------------------------
    type t_SM_Main is (
        s_Idle,
        s_RX_Start_Bit,
        s_RX_Data_Bits,
        s_RX_Stop_Bit,
        s_Cleanup
    );

    signal r_SM_Main : t_SM_Main := s_Idle;

    signal r_RX_Data_R : std_logic := '0';
    signal r_RX_Data   : std_logic := '0';

    signal r_Clk_Count : integer range 0 to g_CLKS_PER_BIT - 1 := 0;
    signal r_Bit_Index : integer range 0 to 7 := 0;

    signal r_RX_Byte : std_logic_vector(7 downto 0) := (others => '0');
    signal r_RX_DV   : std_logic := '0';

    ----------------------------------------------------------------
    -- Counter signals
    ----------------------------------------------------------------
    signal r_N_Limit : integer range 1 to 9 := 9;
    signal r_Counter : integer range 0 to 15 := 0;

    ----------------------------------------------------------------
    -- Clock Divider component
    ----------------------------------------------------------------
    component ClockDiv is
        port (
            clk_in       : in  std_logic;
            reset        : in  std_logic;
            clk_out_5MHz : out std_logic;
            clk_out_2Hz  : out std_logic
        );
    end component;

begin

    ----------------------------------------------------------------
    -- Clock Divider
    --
    -- 50 MHz -> 5 MHz
    -- 50 MHz -> 2 Hz
    ----------------------------------------------------------------
    u_clk_div : ClockDiv
        port map (
            clk_in       => i_Clk,
            reset        => '0',
            clk_out_5MHz => clk_5MHz,
            clk_out_2Hz  => clk_2Hz
        );

    ----------------------------------------------------------------
    -- Double-register incoming serial data
    ----------------------------------------------------------------
    p_SAMPLE : process(clk_5MHz)
    begin
        if rising_edge(clk_5MHz) then
            r_RX_Data_R <= i_RX_Serial;
            r_RX_Data   <= r_RX_Data_R;
        end if;
    end process p_SAMPLE;

    ----------------------------------------------------------------
    -- UART RX State Machine
    ----------------------------------------------------------------
    p_UART_RX : process(clk_5MHz)
    begin
        if rising_edge(clk_5MHz) then

            case r_SM_Main is

                ----------------------------------------------------
                -- IDLE
                ----------------------------------------------------
                when s_Idle =>

                    r_RX_DV   <= '0';
                    r_Clk_Count <= 0;
                    r_Bit_Index <= 0;

                    -- UART idle line is HIGH.
                    -- LOW indicates start bit.
                    if r_RX_Data = '0' then
                        r_SM_Main <= s_RX_Start_Bit;
                    else
                        r_SM_Main <= s_Idle;
                    end if;


                ----------------------------------------------------
                -- START BIT
                ----------------------------------------------------
                when s_RX_Start_Bit =>

                    -- Sample in the middle of the start bit
                    if r_Clk_Count = (g_CLKS_PER_BIT - 1) / 2 then

                        if r_RX_Data = '0' then
                            r_Clk_Count <= 0;
                            r_SM_Main   <= s_RX_Data_Bits;
                        else
                            -- False start
                            r_SM_Main <= s_Idle;
                        end if;

                    else
                        r_Clk_Count <= r_Clk_Count + 1;
                        r_SM_Main   <= s_RX_Start_Bit;
                    end if;


                ----------------------------------------------------
                -- DATA BITS
                ----------------------------------------------------
                when s_RX_Data_Bits =>

                    if r_Clk_Count < g_CLKS_PER_BIT - 1 then

                        r_Clk_Count <= r_Clk_Count + 1;
                        r_SM_Main   <= s_RX_Data_Bits;

                    else

                        r_Clk_Count <= 0;

                        -- UART sends LSB first
                        r_RX_Byte(r_Bit_Index) <= r_RX_Data;

                        if r_Bit_Index < 7 then
                            r_Bit_Index <= r_Bit_Index + 1;
                            r_SM_Main   <= s_RX_Data_Bits;
                        else
                            r_Bit_Index <= 0;
                            r_SM_Main   <= s_RX_Stop_Bit;
                        end if;

                    end if;


                ----------------------------------------------------
                -- STOP BIT
                ----------------------------------------------------
                when s_RX_Stop_Bit =>

                    if r_Clk_Count < g_CLKS_PER_BIT - 1 then

                        r_Clk_Count <= r_Clk_Count + 1;
                        r_SM_Main   <= s_RX_Stop_Bit;

                    else

                        r_RX_DV     <= '1';
                        r_Clk_Count <= 0;
                        r_SM_Main   <= s_Cleanup;

                    end if;


                ----------------------------------------------------
                -- CLEANUP
                ----------------------------------------------------
                when s_Cleanup =>

                    r_SM_Main <= s_Idle;
                    r_RX_DV   <= '0';


                when others =>

                    r_SM_Main <= s_Idle;

            end case;

        end if;
    end process p_UART_RX;


    ----------------------------------------------------------------
    -- Set modulo limit N based on received UART byte
    ----------------------------------------------------------------
    p_SET_LIMIT : process(clk_5MHz)
    begin
        if rising_edge(clk_5MHz) then

            if r_RX_DV = '1' then

                case r_RX_Byte is

                    -- ASCII '1' = x"31"
                    when x"31" =>
                        r_N_Limit <= 1;

                    -- ASCII '2' = x"32"
                    when x"32" =>
                        r_N_Limit <= 2;

                    -- ASCII '3' = x"33"
                    when x"33" =>
                        r_N_Limit <= 3;

                    -- ASCII '4' = x"34"
                    when x"34" =>
                        r_N_Limit <= 4;

                    -- ASCII '5' = x"35"
                    when x"35" =>
                        r_N_Limit <= 5;

                    -- ASCII '6' = x"36"
                    when x"36" =>
                        r_N_Limit <= 6;

                    -- ASCII '7' = x"37"
                    when x"37" =>
                        r_N_Limit <= 7;

                    -- ASCII '8' = x"38"
                    when x"38" =>
                        r_N_Limit <= 8;

                    -- ASCII '9' = x"39"
                    when x"39" =>
                        r_N_Limit <= 9;

                    -- Ignore all other characters
                    when others =>
                        null;

                end case;

            end if;

        end if;
    end process p_SET_LIMIT;


    ----------------------------------------------------------------
    -- Modulo-N counter
    --
    -- Counter updates at 2 Hz.
    --
    -- Example:
    -- N = 5
    -- 0 -> 1 -> 2 -> 3 -> 4 -> 0 -> ...
    ----------------------------------------------------------------
    p_COUNTER : process(clk_2Hz)
    begin
        if rising_edge(clk_2Hz) then

            if r_Counter >= r_N_Limit - 1 then
                r_Counter <= 0;
            else
                r_Counter <= r_Counter + 1;
            end if;

        end if;
    end process p_COUNTER;


    ----------------------------------------------------------------
    -- Convert counter value to 8-bit LED output
    ----------------------------------------------------------------
    o_LED <= std_logic_vector(to_unsigned(r_Counter, 8));

end rtl;