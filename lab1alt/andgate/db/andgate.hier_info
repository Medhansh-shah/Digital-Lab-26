|DUT
input_vector[0] => ANDGATE:add_instance.B
input_vector[1] => ANDGATE:add_instance.A
output_vector[0] << ANDGATE:add_instance.Y


|DUT|ANDGATE:add_instance
A => NAND_2:G1.A
B => NAND_2:G1.B
Y <= NAND_2:G2.Y


|DUT|ANDGATE:add_instance|NAND_2:G1
A => Y.IN0
B => Y.IN1
Y <= Y.DB_MAX_OUTPUT_PORT_TYPE


|DUT|ANDGATE:add_instance|NAND_2:G2
A => Y.IN0
B => Y.IN1
Y <= Y.DB_MAX_OUTPUT_PORT_TYPE


