transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vcom -93 -work work {D:/DigitalLab26/lab1alt/andgate/Gates.vhdl}
vcom -93 -work work {D:/DigitalLab26/lab1alt/andgate/andgate.vhd}

vcom -93 -work work {D:/DigitalLab26/lab1alt/andgate/Testbench.vhdl}
vcom -93 -work work {D:/DigitalLab26/lab1alt/andgate/DUT.vhdl}
vcom -93 -work work {D:/DigitalLab26/lab1alt/andgate/Gates.vhdl}

vsim -t 1ps -L altera -L lpm -L sgate -L altera_mf -L altera_lnsim -L maxv -L rtl_work -L work -voptargs="+acc"  TB

add wave *
view structure
view signals
run -all
