library ieee;
use ieee.std_logic_1164.all;
use work.Gates.all;

entity rotator is
    port(
        L : in std_logic;
        CT2, CT1, CT0 : in std_logic;
        A7, A6, A5, A4, A3, A2, A1, A0 : in std_logic;
        S7, S6, S5, S4, S3, S2, S1, S0 : out std_logic;
    );
end entity;

architecture flow of rotator is
    component mux is
        port(
            X1, X0 : in std_logic;
            S : in std_logic;
            Y : out std_logic
        );
    end component;

    signal B7, B6, B5, B4, B3, B2, B1, B0 : std_logic;
    signal C7, C6, C5, C4, C3, C2, C1, C0 : std_logic;
    signal D7, D6, D5, D4, D3, D2, D1, D0 : std_logic;
    signal E7, E6, E5, E4, E3, E2, E1, E0 : std_logic;

    begin
        
        line11: mux port map(X1 => A0, X0 => A7, S => L, Y => B7);
        line12: mux port map(X1 => A1, X0 => A6, S => L, Y => B6);
        line13: mux port map(X1 => A2, X0 => A5, S => L, Y => B5);
        line14: mux port map(X1 => A3, X0 => A4, S => L, Y => B4);
        line15: mux port map(X1 => A4, X0 => A3, S => L, Y => B3);
        line16: mux port map(X1 => A5, X0 => A2, S => L, Y => B2);
        line17: mux port map(X1 => A6, X0 => A1, S => L, Y => B1);
        line18: mux port map(X1 => A7, X0 => A0, S => L, Y => B0);

        line21: mux port map(X1 => B3, X0 => B7, S => CT2, Y => C7);
        line22: mux port map(X1 => B2, X0 => B6, S => CT2, Y => C6);
        line23: mux port map(X1 => B1, X0 => B5, S => CT2, Y => C5);
        line24: mux port map(X1 => B0, X0 => B4, S => CT2, Y => C4);
        line25: mux port map(X1 => B7, X0 => B3, S => CT2, Y => C3);
        line26: mux port map(X1 => B6, X0 => B2, S => CT2, Y => C2);
        line27: mux port map(X1 => B5, X0 => B1, S => CT2, Y => C1);
        line28: mux port map(X1 => B4, X0 => B0, S => CT2, Y => C0);

        line31: mux port map(X1 => C1, X0 => C7, S => CT1, Y => D7);
        line32: mux port map(X1 => C0, X0 => C6, S => CT1, Y => D6);
        line33: mux port map(X1 => C7, X0 => C5, S => CT1, Y => D5);
        line34: mux port map(X1 => C6, X0 => C4, S => CT1, Y => D4);
        line35: mux port map(X1 => C5, X0 => C3, S => CT1, Y => D3);
        line36: mux port map(X1 => C4, X0 => C2, S => CT1, Y => D2);
        line37: mux port map(X1 => C3, X0 => C1, S => CT1, Y => D1);
        line38: mux port map(X1 => C2, X0 => C0, S => CT1, Y => D0);

        line41: mux port map(X1 => D0, X0 => D7, S => CT0, Y => E7);
        line42: mux port map(X1 => D7, X0 => D6, S => CT0, Y => E6);
        line43: mux port map(X1 => D6, X0 => D5, S => CT0, Y => E5);
        line44: mux port map(X1 => D5, X0 => D4, S => CT0, Y => E4);
        line45: mux port map(X1 => D4, X0 => D3, S => CT0, Y => E3);
        line46: mux port map(X1 => D3, X0 => D2, S => CT0, Y => E2);
        line47: mux port map(X1 => D2, X0 => D1, S => CT0, Y => E1);
        line48: mux port map(X1 => D1, X0 => D0, S => CT0, Y => E0);

        line51: mux port map(X1 => E0, X0 => E7, S => L, Y => S7);
        line52: mux port map(X1 => E1, X0 => E6, S => L, Y => S6);
        line53: mux port map(X1 => E2, X0 => E5, S => L, Y => S5);
        line54: mux port map(X1 => E3, X0 => E4, S => L, Y => S4);
        line55: mux port map(X1 => E4, X0 => E3, S => L, Y => S3);
        line56: mux port map(X1 => E5, X0 => E2, S => L, Y => S2);
        line57: mux port map(X1 => E6, X0 => E1, S => L, Y => S1);
        line58: mux port map(X1 => E7, X0 => E0, S => L, Y => S0);
end architecture;