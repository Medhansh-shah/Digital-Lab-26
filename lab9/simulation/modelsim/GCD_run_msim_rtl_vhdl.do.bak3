transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vcom -93 -work work {D:/SEM 3/WEL LAB/Lab9 files/GCD/comparator.vhd}

vcom -93 -work work {D:/SEM 3/WEL LAB/Lab9 files/GCD/comparator_tb.vhd}

vsim -t 1ps -L altera -L lpm -L sgate -L altera_mf -L altera_lnsim -L fiftyfivenm -L rtl_work -L work -voptargs="+acc"  comparator_tb

add wave *
view structure
view signals
run -all
