transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vcom -93 -work work {D:/DigitalLab26/lab9/subtractor.vhd}
vcom -93 -work work {D:/DigitalLab26/lab9/comparator.vhd}
vcom -93 -work work {D:/DigitalLab26/lab9/zero_detector.vhd}
vcom -93 -work work {D:/DigitalLab26/lab9/reg4.vhd}
vcom -93 -work work {D:/DigitalLab26/lab9/controller.vhd}
vcom -93 -work work {D:/DigitalLab26/lab9/datapath.vhd}
vcom -93 -work work {D:/DigitalLab26/lab9/GCD_top.vhd}

vcom -93 -work work {D:/DigitalLab26/lab9/Testbench.vhdl}

vsim -t 1ps -L altera -L lpm -L sgate -L altera_mf -L altera_lnsim -L fiftyfivenm -L rtl_work -L work -voptargs="+acc"  Testbench

add wave *
view structure
view signals
run -all
